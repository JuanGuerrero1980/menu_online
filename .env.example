# Database
# Connection string for the application (use pooled URL from Neon).
DATABASE_URL=

# Direct connection string for Prisma migrations (use non-pooled URL from Neon).
DIRECT_URL=

# Auth.js secret (generate with: openssl rand -base64 32)
AUTH_SECRET=

# Public URL of the application (used for callbacks and links)
APP_URL=http://localhost:3000

# Image storage provider (e.g. cloudinary)
STORAGE_PROVIDER=

# Cloudinary credentials (only needed when STORAGE_PROVIDER=cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
